+    /// Double-tap Fn latches Remember observation capture onto the recording
+    /// the first tap already started. Returns false when no eligible ordinary
+    /// session is in flight, so the shortcut handler can fall back to ordinary
+    /// handling.
+    func latchObservationMode() -> Bool {
+        guard activeRecordingUseCase == .newSession,
+            recordingState == .starting || recordingState == .recording
+        else { return false }
+
+        activeRecordingUseCase = .observation
+        isObservationMode = true
+        clearActiveRecordingContext()
+        return true
+    }
