+    /// Remember observation capture: transcribe with the same local Parakeet V3
+    /// path, then persist durably. An observation is never pasted, never
+    /// touches the clipboard, never executes a command, and never enters
+    /// ordinary transcription history. A successful save is silent: the pill
+    /// disappears and David returns to what he was doing; the observation is
+    /// inspectable in the Observations window. A failure must tell David,
+    /// because otherwise he reasonably believes the thought was remembered
+    /// when it was not — compactly, via the ordinary notification surface,
+    /// with the audio kept recoverable under Observations/Failed.
+    private func runObservation(on audioURL: URL) async {
+        defer {
+            recordedFile = nil
+            currentSession = nil
+            currentSessionTranscriptionConfiguration = nil
+            shouldCancelRecording = false
+            activePipelineUseCase = .newSession
+            clearActiveRecordingContext()
+        }
+
+        guard let configuration = SyllPhase1Runtime.transcriptionConfiguration(manager: transcriptionModelManager) else {
+            SyllObservationStore.shared.recordFailure(
+                audioURL: audioURL, reason: "Local Parakeet V3 model is unavailable")
+            await failObservation("Observation not saved — audio kept in Observations/Failed")
+            return
+        }
+
+        do {
+            let rawTranscript = try await serviceRegistry.transcribe(
+                audioURL: audioURL,
+                model: configuration.model,
+                context: configuration.requestContext
+            )
+            let heard = TranscriptionOutputFilter.filter(rawTranscript)
+                .trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !heard.isEmpty else {
+                SyllObservationStore.shared.recordFailure(
+                    audioURL: audioURL, reason: "Nothing was recognized")
+                await failObservation("Observation not saved — nothing recognized; audio kept")
+                return
+            }
+            let text = WordReplacementService.shared.applyReplacements(to: heard, using: modelContext)
+            let duration = await AudioFileMetadata.duration(for: audioURL)
+            try SyllObservationStore.shared.save(
+                audioURL: audioURL,
+                originalText: heard,
+                text: text,
+                audioDurationSeconds: duration,
+                model: configuration.model.name
+            )
+            // Success is silent: no outcome card, toast, sound, or clipboard.
+            isObservationMode = false
+            recordingState = .idle
+            await recorderUIManager?.dismissRecorderPanel()
+        } catch {
+            let message = (error as? LocalizedError)?.errorDescription ?? error.localizedDescription
+            SyllObservationStore.shared.recordFailure(
+                audioURL: audioURL, reason: "Transcription or saving failed: \(message)")
+            await failObservation("Observation not saved — \(message); audio kept")
+        }
+    }
+
+    private func failObservation(_ title: String) async {
+        isObservationMode = false
+        recordingState = .idle
+        NotificationManager.shared.showNotification(title: title, type: .error, duration: 7.0)
+        await recorderUIManager?.dismissRecorderPanel()
+    }
+
     private func showCommandOutcome(_ outcome: SyllCommandOutcome) {
