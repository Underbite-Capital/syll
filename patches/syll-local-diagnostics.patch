+        ) else {
+            recovery = nil
+            return .clipboardChangedElsewhere
+        }
+        pasteboard.clearContents()
+        if !pending.snapshot.isEmpty {
+            pasteboard.writeObjects(pasteboardItems(from: pending.snapshot))
+        }
+        recovery = nil
+        return .restoredPrevious
+    }
 
